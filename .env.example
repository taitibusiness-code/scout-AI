# Scout reads shell environment variables; this file is documentation only.
SCOUT_LLM_PROVIDER=ollama
SCOUT_OLLAMA_MODEL=qwen3:8b
SCOUT_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Required for discover commands using Google Custom Search.
GOOGLE_CSE_API_KEY=replace_me
GOOGLE_CSE_CX=replace_me

# Optional, only when SCOUT_LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=replace_me

SCOUT_DB_PATH=./scout.db
SCOUT_LOG_PATH=./scout_log.jsonl
