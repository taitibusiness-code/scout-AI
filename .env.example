# Scout reads shell environment variables; this file is documentation only.
SCOUT_LLM_PROVIDER=ollama
SCOUT_OLLAMA_MODEL=qwen3:8b
SCOUT_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Search provider selection. SEARCH_PROVIDERS, when set, takes precedence.
# Default: exa. Valid names: exa, tavily, serper, google_cse.
SEARCH_PROVIDER=exa
# SEARCH_PROVIDERS=exa,tavily,serper

# Optional provider credentials. Set only those used by the selected provider/chain.
EXA_API_KEY=replace_me
TAVILY_API_KEY=replace_me
SERPER_API_KEY=replace_me

# Required only when SEARCH_PROVIDER=google_cse or google_cse is in SEARCH_PROVIDERS.
GOOGLE_CSE_API_KEY=replace_me
GOOGLE_CSE_CX=replace_me

# Optional official Google Places API (New) discovery. Keep disabled unless
# Google Cloud billing and Places API (New) are enabled for this key.
PLACES_PROVIDER_ENABLED=false
GOOGLE_MAPS_API_KEY=replace_me

# Optional, only when SCOUT_LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=replace_me

SCOUT_DB_PATH=./scout.db
SCOUT_LOG_PATH=./scout_log.jsonl
